{
  "name": "drupal/viewsreference_sift",
  "description": "Lets editors narrow a Views Reference field's embedded View by choosing entities for its contextual filters.",
  "type": "drupal-module",
  "license": "GPL-2.0-or-later",
  "homepage": "https://www.drupal.org/project/viewsreference_sift",
  "support": {
    "issues": "https://www.drupal.org/project/issues/viewsreference_sift",
    "source": "https://git.drupalcode.org/project/viewsreference_sift"
  },
  "require": {
    "php": ">=8.3",
    "drupal/core": "^11.3",
    "drupal/viewsreference": "^2.0.0-beta14"
  },
  "require-dev": {
    "drupal/coder": "^9.0"
  },
  "minimum-stability": "beta",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "*": false
    }
  }
}

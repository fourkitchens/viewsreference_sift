{
  "name": "fourkitchens/viewsreference_sift",
  "description": "Lets editors narrow a Views Reference field's embedded View by choosing entities for its contextual filters.",
  "type": "drupal-module",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/fourkitchens/viewsreference_sift",
  "support": {
    "issues": "https://github.com/fourkitchens/viewsreference_sift/issues",
    "source": "https://github.com/fourkitchens/viewsreference_sift"
  },
  "require": {
    "php": ">=8.3",
    "drupal/core": "^11.3",
    "drupal/viewsreference": "^2.0.0-beta14"
  },
  "require-dev": {
    "drupal/coder": "^9.0",
    "drush/drush": "^13"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    }
  ],
  "minimum-stability": "beta",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "*": false
    }
  }
}

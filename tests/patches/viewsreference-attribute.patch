Date: Fri, 6 Nov 2026 09:25:35 -0600
Subject: [PATCH] fix: support attribute discovery for Views Reference settings

---
 src/Attribute/ViewsReferenceSetting.php       | 37 +++++++++++++++++++
 .../ViewsReferenceArgument.php                |  3 ++
 .../ViewsReferenceHeader.php                  |  3 ++
 .../ViewsReferenceLimit.php                   |  3 ++
 .../ViewsReferenceOffset.php                  |  3 ++
 .../ViewsReferencePager.php                   |  3 ++
 .../ViewsReferenceTitle.php                   |  3 ++
 src/Plugin/ViewsReferenceSettingManager.php   |  9 ++++-
 8 files changed, 63 insertions(+), 1 deletion(-)
 create mode 100644 src/Attribute/ViewsReferenceSetting.php

diff --git a/src/Attribute/ViewsReferenceSetting.php b/src/Attribute/ViewsReferenceSetting.php
new file mode 100644
index 0000000..f4342ad
--- /dev/null
+++ b/src/Attribute/ViewsReferenceSetting.php
@@ -0,0 +1,37 @@
+<?php
+
+namespace Drupal\viewsreference\Attribute;
+
+use Drupal\Component\Plugin\Attribute\Plugin;
+use Drupal\Core\StringTranslation\TranslatableMarkup;
+
+/**
+ * Defines a Views Reference setting plugin attribute.
+ *
+ * @see \Drupal\viewsreference\Plugin\ViewsReferenceSettingManager
+ */
+#[\Attribute(\Attribute::TARGET_CLASS)]
+class ViewsReferenceSetting extends Plugin {
+
+  /**
+   * Constructs a Views Reference setting attribute.
+   *
+   * @param string $id
+   *   The plugin ID.
+   * @param \Drupal\Core\StringTranslation\TranslatableMarkup|null $label
+   *   (optional) The label of the plugin.
+   * @param mixed $default_value
+   *   (optional) The field default value.
+   * @param class-string|null $deriver
+   *   (optional) The deriver class.
+   */
+  public function __construct(
+    string $id,
+    public readonly ?TranslatableMarkup $label = NULL,
+    public readonly mixed $default_value = '',
+    ?string $deriver = NULL,
+  ) {
+    parent::__construct($id, $deriver);
+  }
+
+}
diff --git a/src/Plugin/ViewsReferenceSetting/ViewsReferenceArgument.php b/src/Plugin/ViewsReferenceSetting/ViewsReferenceArgument.php

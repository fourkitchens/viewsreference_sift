 use Drupal\Core\Utility\Token;
@@ -11,2 +12,3 @@ use Drupal\views\Views;
 use Drupal\views\ViewExecutable;
+use Drupal\viewsreference\Attribute\ViewsReferenceSetting;
 use Drupal\viewsreference\Plugin\ViewsReferenceSettingInterface;
@@ -23,2 +25,3 @@ use Symfony\Component\DependencyInjection\ContainerInterface;
  */
+#[ViewsReferenceSetting(id: 'argument', label: new TranslatableMarkup('Argument'))]
 class ViewsReferenceArgument extends PluginBase implements ViewsReferenceSettingInterface, ContainerFactoryPluginInterface {

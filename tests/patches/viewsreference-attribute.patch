diff --git a/src/Plugin/ViewsReferenceSettingManager.php b/src/Plugin/ViewsReferenceSettingManager.php
index e85a7e4..54b3ac6 100644
--- a/src/Plugin/ViewsReferenceSettingManager.php
+++ b/src/Plugin/ViewsReferenceSettingManager.php
@@ -7,2 +7,5 @@ use Drupal\Core\Extension\ModuleHandlerInterface;
 use Drupal\Core\Plugin\DefaultPluginManager;
+use Drupal\Core\Plugin\Discovery\AttributeDiscoveryWithAnnotations;
+use Drupal\viewsreference\Annotation\ViewsReferenceSetting as ViewsReferenceSettingAnnotation;
+use Drupal\viewsreference\Attribute\ViewsReferenceSetting;
 
@@ -25,3 +28,7 @@ class ViewsReferenceSettingManager extends DefaultPluginManager {
   public function __construct(\Traversable $namespaces, CacheBackendInterface $cache_backend, ModuleHandlerInterface $module_handler) {
-    parent::__construct('Plugin/ViewsReferenceSetting', $namespaces, $module_handler, 'Drupal\viewsreference\Plugin\ViewsReferenceSettingInterface', 'Drupal\viewsreference\Annotation\ViewsReferenceSetting');
+    // Drupal 10.0 and 10.1 expect the annotation as the fifth argument.
+    $discovery_classes = class_exists(AttributeDiscoveryWithAnnotations::class)
+      ? [ViewsReferenceSetting::class, ViewsReferenceSettingAnnotation::class]
+      : [ViewsReferenceSettingAnnotation::class];
+    parent::__construct('Plugin/ViewsReferenceSetting', $namespaces, $module_handler, ViewsReferenceSettingInterface::class, ...$discovery_classes);
 
